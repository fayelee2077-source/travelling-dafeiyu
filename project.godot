; Engine configuration file.

config_version=5

[application]

config/name="Living Dock Companion"
config/name.dafeiyu="旅行的大肥鱼"
config/use_custom_user_dir.dafeiyu=true
config/custom_user_dir_name.dafeiyu="旅行的大肥鱼"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")
boot_splash/show_image=false

[autoload]

Settings="*res://scripts/settings.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font.web="res://assets/fonts/NotoSansSC-Regular.otf"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=true
